# Bu fayl faqat NAMUNA va GitHub'ga yuklanadi — bu yerga haqiqiy token yoki parol YOZMANG!
# Ishlatish: nusxasini ".env" nomi bilan saqlang (u GitHub'ga chiqmaydi) va qiymatlarni o'sha yerga yozing.
# Serverda (Railway) bu qiymatlar Variables bo'limiga yoziladi.

# --- Telegram bot (@BotFather dan) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=YukGoobot

# --- Yandex Maps (developer.tech.yandex.ru → "JavaScript API va HTTP Geocoder") ---
YANDEX_MAPS_API_KEY=

# --- Sayt manzili (bot xabarlaridagi havolalar uchun; serverda — Railway domeningiz) ---
PUBLIC_URL=http://localhost:8080

# --- Xavfsizlik ---
# Kamida 32 belgili tasodifiy satr. Kompyuterda bo'sh qoldirsangiz ham bo'ladi (qatorni o'chiring).
JWT_SECRET=
APP_DEV_MODE=false

# --- Ega (owner) hisobi: birinchi ishga tushishda yaratiladi ---
OWNER_PHONE=+998901234567
OWNER_FIRST_NAME=Ism
OWNER_LAST_NAME=Familiya
OWNER_PASSWORD=almashtiring-buni

# --- Ma'lumotlar bazasi ---
DB_PASSWORD=kuchli-parol
